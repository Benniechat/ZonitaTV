# ==============================================================================
# ZONITA TV - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env on the production host or configure these secrets in your
# cloud provider dashboard (Laravel Cloud / Railway / AWS ECS / Render).
# ==============================================================================

APP_NAME="Zonita TV"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_APP_KEY_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://zonitatv.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging & Observability
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Production Database (PostgreSQL / Supabase / Neon / RDS)
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DB_SSLMODE=require

# High-Performance Session, Cache & Queue (Redis or Managed DB)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.zonitatv.com
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# Media Delivery & Storage (Cloudinary Enterprise CDN)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_SECURE=true

# Google OAuth & Identity Federation
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI="https://zonitatv.com/auth/google/callback"

# Analytics & Webmaster Verification
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
GOOGLE_SITE_VERIFICATION=google98a49cab5be19ce2

# Transactional Mail & System Notifications
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@zonitatv.com
MAIL_PASSWORD=YOUR_MAILGUN_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@zonitatv.com"
MAIL_FROM_NAME="Zonita TV Network"

# Legal, Copyright & WhatsApp Community Dispatch
DMCA_NOTICE_EMAIL=copyright@zonitatv.com
WHATSAPP_COMMUNITY_URL="https://chat.whatsapp.com/ZonitaTVCommunity"

# Security & Rate Limiting Overrides
RATE_LIMIT_SEARCH=30
RATE_LIMIT_API=60
RATE_LIMIT_TELEMETRY=120
RATE_LIMIT_REPORTS=5
